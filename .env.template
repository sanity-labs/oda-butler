# Anthropic
ANTHROPIC_API_KEY=

# Slack (create app from `bun run manifest`)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Oda auto-relogin (recommended for production).
# When set, the bot silently re-authenticates if the Oda session expires.
# Without these, you'll need to run `bun run oda:login` manually after expiry.
# ODA_EMAIL=office@example.com
# ODA_PASSWORD=...

# Comma-separated Slack channels where the bot is allowed to respond.
# Names with or without a leading `#`.
ALLOWED_CHANNELS=oda-bot

# Office identity (shown in the agent's replies and `<current_time>` block).
# All optional; sensible defaults if unset.
# OFFICE_NAME="Acme's Oslo office"
# OFFICE_MANAGER="Sara, the office manager"
# OFFICE_TIMEZONE=Europe/Oslo

# Optional overrides:
# LOG_LEVEL=info                              # debug | info | warn | error | silent
# SANITY_ODA_DATA_DIR=/var/data/sanity-oda    # cookie store, defaults to <project>/data/
# ODA_BOT_DB_URL=file:/var/data/oda.db        # Mastra memory, defaults to file:./data/oda.db
