{
  "name": "slack-oda",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --hot run src/index.ts",
    "manifest": "bun run scripts/generate-manifest.ts",
    "test": "vitest run",
    "oda:login": "bun run scripts/oda-auth.ts login",
    "oda:logout": "bun run scripts/oda-auth.ts logout",
    "oda:whoami": "bun run scripts/oda-auth.ts whoami"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@chat-adapter/slack": "^4.27.0",
    "@mastra/core": "^1.32",
    "@mastra/libsql": "^1.10.0",
    "@mastra/memory": "^1.17.5",
    "es-toolkit": "^1.46.1",
    "zod": "^4.4.3"
  },
  "trustedDependencies": []
}
